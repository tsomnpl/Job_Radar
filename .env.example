# TEMPLATE only — committed to git with EMPTY secrets on purpose.
# Copy to `.env` for local. Production keys live in Vercel → Settings → Environment Variables.
# Never paste pk_/sk_/rd_sk_/re_ values into this file or into git.

# Clerk Development = pk_test_ / sk_test_ (Frontend API *.clerk.accounts.dev).
# Clerk Production  = pk_live_ / sk_live_ (needs a domain you own).
# Do not replace Production keys with test keys.
# NEXT_PUBLIC_CLERK_PROXY_URL is Production-only. Leave empty with pk_test_ —
# Clerk proxying does not work on development instances.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_PROXY_URL=

# Production (Vercel) REQUIRES PostgreSQL. SQLite file: URLs crash serverless.
# Local: docker compose up -d && use the URL below.
DATABASE_URL="postgresql://jobradar:jobradar@localhost:5432/jobradar"
# Prisma Postgres on Vercel also works: paste the postgres:// URL, not the JSON array [ "..." ].

# RodiumAI — OpenAI-compatible gateway (server-only, never expose the key)
RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_MODEL=rodiumai/smart

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Clerk user IDs with admin rights (import, moderation)
ADMIN_CLERK_USER_IDS=

# Resend — server-only. Never put RESEND_API_KEY in NEXT_PUBLIC_*.
# Emails are not functional until both are set with a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
