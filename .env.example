# Clerk (leave empty to run the local demo mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# SQLite by default. Switch to PostgreSQL in production if needed.
DATABASE_URL="file:./dev.db"

# RodiumAI — OpenAI-compatible gateway
RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_MODEL=rodiumai/smart

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Clerk user IDs with admin rights (import, moderation)
ADMIN_CLERK_USER_IDS=
