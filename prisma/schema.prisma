generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  clerkUserId           String         @unique
  email                 String?
  name                  String?
  role                  String         @default("USER")
  locale                String         @default("fr")
  emailNotifications    Boolean        @default(false)
  newOpportunityAlerts  Boolean        @default(true)
  deadlineAlerts        Boolean        @default(true)
  weeklyDigest          Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  profile               Profile?
  searches              Search[]
  matches               Match[]
  savedJobs             SavedJob[]
  applications          Application[]
  notifications         Notification[]
  jobViews              JobView[]
  emailLogs             EmailLog[]
  lastAlertEmailAt      DateTime?
}

model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String?
  summary          String?
  cvText           String?
  skillsJson       String    @default("[]")
  languagesJson    String    @default("[]")
  locationsJson    String    @default("[]")
  education        String?
  seniority        String?
  yearsExperience  Int?
  remotePreference   String?
  domainsJson        String    @default("[]")
  contractTypesJson  String    @default("[]")
  keywordsJson       String    @default("[]")
  parsedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Job {
  id              String         @id @default(cuid())
  title           String
  company         String
  companyLogo     String?
  location        String
  country         String?
  remoteType      String         @default("unspecified")
  contractType    String         @default("other")
  seniority       String         @default("unspecified")
  salaryMin       Int?
  salaryMax       Int?
  currency        String         @default("")
  skillsJson      String         @default("[]")
  languagesJson   String         @default("[]")
  description     String
  requirements    String?
  education       String?
  experience      String?
  benefits        String?
  duration        String?
  language        String         @default("fr")
  sourceUrl       String?
  applicationUrl  String?
  source          String         @default("manual")
  category        String?
  contactInfo     String?
  postedAt        DateTime       @default(now())
  deadline        DateTime?
  startDate       DateTime?
  endDate         DateTime?
  importedAt      DateTime       @default(now())
  fingerprint     String         @unique
  active          Boolean        @default(true)
  status          String         @default("published")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  matches         Match[]
  savedJobs       SavedJob[]
  applications    Application[]
  jobViews        JobView[]
  emailLogs       EmailLog[]
}

model Search {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query       String
  intentJson  String
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())
}

model Match {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  searchId    String?
  score       Int
  reasonsJson String
  gapsJson    String
  narrative   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("watching")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("SYSTEM")
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JobView {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  seenAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model EmailLog {
  id        String    @id @default(cuid())
  userId    String?
  jobId     String?
  type      String
  status    String
  eventKey  String    @unique
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model ImportBatch {
  id           String   @id @default(cuid())
  actorId      String?
  filename     String?
  format       String
  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  skippedCount Int      @default(0)
  errorJson    String?
  createdAt    DateTime @default(now())
}
